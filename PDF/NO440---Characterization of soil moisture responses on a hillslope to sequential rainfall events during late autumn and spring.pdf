         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Hydrology: Soil moisture; Hydrology: Monitoring networks; Hydrology: Streamflow; Hydrology: Eco&amp;hyphen;hydrology</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Characterization of soil moisture responses on a hillslope to sequential rainfall events during late autumn and spring</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Sanghyun Kim</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
